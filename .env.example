# Copy to .env (not tracked). Sourced by every jobs/*.sh wrapper.
# Root of all downloaded / derived data. Paths in the index are stored relative
# to this, so moving to permanent storage only means changing this line.
RIRDB_ROOT=/gpfs/scratch/eey119/rir-data
# Hugging Face cache for CLAP weights (embed env)
HF_HOME=/gpfs/scratch/eey119/rir-data/models/hf
