# Python
__pycache__/
*.py[oc]
build/
dist/
*.egg-info
.venv

# IDE
.vscode
.idea
.DS_Store

# Pixi (the lock IS committed in this repo, for reproducible metrics)
.pixi/*
!.pixi/config.toml

# SLURM logs
qlogs/*
!qlogs/.gitkeep

# Local env / user-managed agent notes
.env
CLAUDE.md

